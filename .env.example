# Copiar a .env y ajustar. El .env real no se versiona.

# --- Base de datos -----------------------------------------------------------
# El puerto es el 6432 de PgBouncer, no el 5432 de PostgreSQL. La composición
# no publica el 5432 al host justamente para que esta variable no pueda
# apuntar a la base directamente: en modo transacción hay restricciones que el
# código debe respetar (ver backend/internal/datos/doc.go) y solo se
# manifiestan pasando por el pooler.
DATABASE_URL=postgres://app_dev:dev@localhost:6432/reservas?sslmode=disable

# --- Caché y bus -------------------------------------------------------------
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# --- Almacenamiento de objetos (comprobantes, RF-34) -------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-desarrollo

# --- Correo (RF-10). Mailpit captura todo en http://localhost:8025 -----------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Stripe ------------------------------------------------------------------
# Claves de prueba. Nunca claves reales en este archivo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
