# Copiar a .env y ajustar. El .env real no se versiona.

# --- Base de datos -----------------------------------------------------------
# El puerto es el 6432 de PgBouncer, no el 5432 de PostgreSQL. La composición
# no publica el 5432 al host justamente para que esta variable no pueda
# apuntar a la base directamente: en modo transacción hay restricciones que el
# código debe respetar (ver backend/internal/datos/doc.go) y solo se
# manifiestan pasando por el pooler.
DATABASE_URL=postgres://app_dev:dev@localhost:6432/reservas?sslmode=disable

# --- Caché y bus -------------------------------------------------------------
# Valkey tiene dos trabajos, los dos de ARQ-01: cachear las proyecciones de
# disponibilidad con los 2 s que RNF-10 autoriza (el 90% del tráfico de RNF-03)
# y sostener las cuotas de RNF-08. Su ausencia no impide arrancar a `consulta`
# —sirve igual, más despacio— pero sí a `identidad`, que sin cuotas no puede
# mandar códigos con seguridad.
VALKEY_URL=redis://localhost:6379

# NATS con JetStream: donde el relay deja los eventos del outbox. Sin esto el
# binario `trabajadores` no arranca, porque un relay sin bus no releva nada.
NATS_URL=nats://localhost:4222

# --- Trabajadores asíncronos -------------------------------------------------
# El del expirador es el que se nota: es cuánto tiempo un cupo abandonado sigue
# pareciendo ocupado en la agenda de todo el mundo (RF-27).
INTERVALO_EXPIRADOR=10s
INTERVALO_TRANSICIONES=1m
INTERVALO_RELAY=1s

# Los cuatro que tocan dinero o metricas. El del conciliador es el mas lento a
# proposito: cada pasada son llamadas a Stripe, y el camino normal es que el
# webhook llegue en segundos, asi que casi nunca encuentra nada.
INTERVALO_CONCILIADOR=30s
INTERVALO_REEMBOLSOS=1m
INTERVALO_COMPROBANTES=10s
INTERVALO_METRICAS=5m
INTERVALO_ESPERA=15s

# Cuanto se espera a que llegue el webhook antes de ir a preguntarle a Stripe
# (RF-33). Corto de mas multiplica llamadas para nada; largo de mas deja al
# cliente mirando una reserva pendiente que ya pago. Tiene que ser holgadamente
# menor que TTL_RESERVA, que es la ventana donde esto puede actuar.
GRACIA_CONCILIACION=2m

# Cuánto se espera desde el inicio de la cita antes de darla por ausencia
# (RF-28). Es el único de estos números con consecuencias sobre el dinero, y
# acabará viviendo por tenant cuando exista RF-16.
UMBRAL_NO_SHOW=15m

# --- Almacenamiento de objetos (comprobantes, RF-34) -------------------------
# El unico inquilino de MinIO en ARQ-01. Su ausencia NO impide arrancar: los
# comprobantes se emiten igual, con su numero y sus datos congelados, y lo unico
# que falta es el documento, que se sube en cuanto MinIO vuelva.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-desarrollo

# https en despliegue. En local MinIO va sin TLS.
MINIO_SEGURO=false

# --- Correo (RF-10). Mailpit captura todo en http://localhost:8025 -----------
SMTP_HOST=localhost
SMTP_PORT=1025
CORREO_REMITENTE=reservas@localhost

# --- Identidad del cliente (RF-02) -------------------------------------------
# Firma los tokens de acceso que se entregan al acertar el código. Lo exigen
# identidad (que los firma) y consulta y nucleo (que los verifican): sin él se
# niegan a arrancar, porque un servicio que no comprueba la firma no rechaza
# nada, sirve los datos igual.
#
# Es HMAC, así que firmar y verificar usan la MISMA clave. El valor de abajo es
# para desarrollo y no debe salir de aquí; en despliegue sale de un Secret.
TOKEN_SECRETO=secreto-de-desarrollo-no-usar-en-produccion

# Vigencias. El código sigue a RF-19 (seis dígitos, corta vida). El token de
# acceso es corto porque no se puede revocar: un invitado no tiene sesión que
# gestionar, así que caducar pronto es su única defensa.
TTL_CODIGO=5m
TTL_ACCESO=15m

# Límites de RF-12: intentos de canje antes de quemar el código (A2) y códigos
# que se pueden pedir por destino en una hora (A11).
MAX_INTENTOS_CODIGO=3
MAX_ENVIOS_HORA=3

# --- Stripe (RF-01, RF-33) ---------------------------------------------------
# Claves de PRUEBA. Nunca claves reales en este archivo: se versiona.
#
# Las exigen `pagos` y `trabajadores`, que son los dos binarios que hablan con
# Stripe. `consulta` NO, aunque sirva el comprobante de RF-34: leer un
# comprobante ya emitido no llama a Stripe, y repartir la clave secreta a un
# componente que no la usa solo aumenta las formas de filtrarla.

# sk_test_... — autoriza a crear cobros. Es la credencial mas peligrosa del
# sistema. Del panel de Stripe, en modo prueba.
STRIPE_SECRET_KEY=

# pk_test_... — inicializa Stripe.js en el navegador. Se sirve desde la API y no
# se empotra en el frontend al construirlo: la clave es del entorno, no del
# artefacto, y empotrarla obliga a un build por entorno y a redesplegar el
# frontend para rotarla.
STRIPE_PUBLISHABLE_KEY=

# whsec_... — firma los eventos entrantes. Sin el, cualquiera que conozca la URL
# del webhook puede confirmar reservas que nadie pago, asi que el binario se
# niega a arrancar si falta.
#
# En local lo imprime `stripe listen` al arrancar:
#
#   stripe listen --forward-to localhost:8084/v1/webhooks/stripe
#
# Es distinto del secreto del endpoint configurado en el panel: el de la CLI se
# regenera en cada sesion de escucha.
STRIPE_WEBHOOK_SECRET=
